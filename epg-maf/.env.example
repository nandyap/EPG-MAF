# ─────────────────────────────────────────────────────────────────────
# EGP Window — MAF implementation
# Local developer template. Never commit real secrets.
# In dev/preprod/prod values come from Key Vault via ACA secretRefs.
# ─────────────────────────────────────────────────────────────────────

# ── Environment ─────────────────────────────────────────────────────
EGP_ENV=dev
EGP_SERVICE_VERSION=0.1.0-dev
EGP_LOG_LEVEL=DEBUG

# ── LLM (Compass via APIM) ─────────────────────────────────────────
# In prod, LLM_BASE_URL points at the APIM AI-gateway. For local dev,
# point at a WireMock or OpenAI-compatible mock server.
LLM_API_KEY=replace_me_with_local_dev_key
LLM_BASE_URL=http://localhost:9090/compass/v1
LLM_TIMEOUT_SECONDS=30

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=egp
POSTGRES_USER=egp_agent_ro
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_USE_MANAGED_IDENTITY=false
POSTGRES_SSL_MODE=disable
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SECONDS=5
POSTGRES_STATEMENT_TIMEOUT_SECONDS=30

# ── Cosmos DB (session / thread state) ─────────────────────────────
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_DATABASE=egp
COSMOS_CONTAINER=sessions
COSMOS_USE_MANAGED_IDENTITY=false
# Emulator well-known key (safe to commit — it's the public emulator secret)
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_SESSION_TTL_SECONDS=86400

# ── Prompts ─────────────────────────────────────────────────────────
# Source of truth for prompts. 'bundle' = use local files only.
# 'foundry' = try Foundry Prompt Catalog first, fall back to bundle.
PROMPTS_SOURCE=bundle
PROMPTS_FOUNDRY_ENDPOINT=
PROMPTS_FOUNDRY_TIMEOUT_SECONDS=3

# ── Orchestration ──────────────────────────────────────────────────
# Sequential is the Phase 1 default; parallel is the implemented alternate
# (Section 2.2 of engineering-implementation-plan.md).
ORCH_DISPATCH_MODE=sequential
ORCH_MAX_FANOUT_WIDTH=1
ORCH_ITERATION_BUDGET=12
