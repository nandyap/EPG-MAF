# ── Backend contract ───────────────────────────────────────────────
# Where the /api/* proxy in app/api/[...path]/route.ts forwards to.
# In dev this is the smoke server (scripts/serve_smoke.py).
BACKEND_URL=http://localhost:8000

# ── Dev-only stub bearer ───────────────────────────────────────────
# The smoke server's StubAuthenticator parses this as JSON claims.
# In prod, Container Apps Easy Auth injects the real principal and
# NEXT_PUBLIC_DEV_BEARER MUST NOT be set.
NEXT_PUBLIC_DEV_BEARER={"oid":"demo","tid":"demo","roles":["Clinician"],"name":"Dev Clinician","exp":9999999999}
