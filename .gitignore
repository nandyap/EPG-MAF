# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── Virtual environments ───────────────────────────────────────────
.venv/
venv/
/env/
/ENV/

# ── Environment / secrets ──────────────────────────────────────────
.env
.env.local
.env.*.local
# keep .env.example (template) tracked
!.env.example

# ── LangGraph / LangSmith dev artefacts ────────────────────────────
.langgraph_api/
.langgraph/
.langsmith/

# ── IDE / editor / OS ──────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Logs / temp ────────────────────────────────────────────────────
*.log
logs/
tmp/
.cache/

# ── Local working notes (never committed) ──────────────────────────
# e.g. PROJECT-HANDOFF.local.md — a running engineering handoff used to
# brief a fresh chat session. Reference material, not project artefacts.
*.local.md
